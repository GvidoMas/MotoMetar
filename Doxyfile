# Project name
PROJECT_NAME           = "MotoMetar"

# Where docs will go
OUTPUT_DIRECTORY       = docs
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO

# Source files to document
INPUT                  = wokwi
FILE_PATTERNS          = *.c *.h *.ino *.cpp
RECURSIVE              = YES
EXTENSION_MAPPING = ino=C++

# Tell Doxygen to document everything
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
INPUT_ENCODING         = UTF-8
